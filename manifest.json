{
  "manifest_version": 3,
  "name": "Triage",
  "version": "0.1.3",
  "description": "Tareas rápidas para resolver en el momento, en la barra lateral.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage", "tabs", "menus", "contextualIdentities", "cookies"],
  "background": {
    "scripts": ["contexts.js", "background.js"]
  },
  "action": {
    "default_title": "Mostrar/ocultar Triage",
    "default_icon": "icons/icon.svg"
  },
  "sidebar_action": {
    "default_title": "Triage",
    "default_panel": "triage.html?view=sidebar",
    "default_icon": "icons/icon.svg",
    "open_at_install": false
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Mostrar/ocultar Triage en la barra lateral"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "triage@asmerkin.local",
      "update_url": "https://raw.githubusercontent.com/asmerkin/firefox-triage/updates/updates.json",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
